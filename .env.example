# Gallery app variables. Set these in the Vercel project (Settings, Environment Variables).
# For local dev copy to .env.local.

# Neon connection string (Vercel sets this when you add the Neon integration).
# Local dev: pglite://./.data/pg  (embedded Postgres, tables are created automatically)
DATABASE_URL=

# Admin login (one account)
ADMIN_EMAIL=piperlvaughan@gmail.com
ADMIN_PASSWORD_HASH=pbkdf2:100000:<salt>:<hash>   # npm run hash-password -- "password"
SESSION_SECRET=                                    # openssl rand -hex 32

# Authenticates the daily cron call. Any long random string.
CRON_SECRET=

# Used for share links shown in the admin
APP_URL=https://www.lilylynnephotography.com

# Cloudflare R2 (private bucket + token scoped to it)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Local dev only, points at `npm run mock-s3`:
# R2_ENDPOINT=http://localhost:9477

# Already used by the contact form
ALTCHA_HMAC_KEY=
RESEND_API_KEY=
